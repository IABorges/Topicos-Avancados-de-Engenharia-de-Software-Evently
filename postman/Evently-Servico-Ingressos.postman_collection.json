  },
  "item": [
    {
      "name": "00 Reset dos dados de demonstração",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/dev/reset"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 confirmarPresenca - sucesso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_ana}}"
          }
        ],
        "url": "{{baseUrl}}/convites/10/confirmacao"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"conviteId = 10\", () => pm.expect(pm.response.json()[\"conviteId\"]).to.eql(10));",
              "pm.test(\"situacao = 'CONFIRMADO'\", () => pm.expect(pm.response.json()[\"situacao\"]).to.eql(\"CONFIRMADO\"));"
            ]
          }
        }
